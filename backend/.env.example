APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_BASE_PATH=JusTraduz
APP_ENV=production
APP_URL=https://seudominio.com.br/JusTraduz

DB_HOST=localhost
DB_PORT=3307
DB_NAME=justraduz
DB_USER=root
DB_PASS=
# Opcional para CI/testes locais. Em producao, deixe vazio e use DB_HOST/DB_NAME.
DB_DSN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Para produção com dados de usuários, use um projeto com faturamento ativo
# e contrato de tratamento de dados adequado. Não use cota gratuita.
GEMINI_DATA_PROCESSING_APPROVED=false

DATAJUD_API_KEY=
DATAJUD_API_BASE_URL=
DATAJUD_SSL_VERIFY=
DATAJUD_CONNECT_TIMEOUT=
DATAJUD_TIMEOUT=
DATAJUD_CACHE_TTL_HOURS=24

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@justraduz.local
MAIL_FROM_NAME=JusTraduz
MAIL_LOG_ONLY=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9999/JusTraduz/backend/public/index.php?rota=/auth/google/callback

HEALTHCHECK_URL=https://seudominio.com.br/JusTraduz/backend/public/index.php?rota=/health
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAYS=14

# P1 - operacao
DOCUMENT_STORAGE_PATH=backend/storage/documents
ATTACHMENT_STORAGE_PATH=backend/storage/message-attachments
CLAMAV_BINARY=
OCR_ENABLED=false
OCR_TESSERACT_BINARY=
OCR_LANGUAGE=por+eng
ASYNC_JOBS_ENABLED=false
USAGE_DAILY_DOCUMENT_UPLOADS=20
USAGE_DAILY_DOCUMENT_AI=10
USAGE_DAILY_AI_CHAT=40
USAGE_DAILY_DATAJUD_CNJ=20
USAGE_DAILY_OCR=10
