APP_ENV=local
APP_DEBUG=false
APP_URL=https://example.com/JusTraduz
APP_PUBLIC_URL=https://example.com/JusTraduz
HEALTHCHECK_URL=https://example.com/JusTraduz/backend/public/index.php?rota=/health
APP_BASE_PATH=JusTraduz
APP_TIMEZONE=America/Sao_Paulo
SESSION_SECURE=false
CSRF_SECRET=
HEALTHCHECK_TOKEN=
HEALTHCHECK_LOG_FAILURES=false

DB_DSN=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=justraduz
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DATA_PROCESSING_APPROVED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MAIL_LOG_ONLY=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@justraduz.local
MAIL_FROM_NAME=JusTraduz

DATAJUD_API_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=
DATAJUD_SSL_VERIFY=true
DATAJUD_CONNECT_TIMEOUT=8
DATAJUD_TIMEOUT=20
DATAJUD_CACHE_TTL_HOURS=24
OAB_API_URL=

PAYMENT_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BILLING_TYPE=UNDEFINED
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_CPF_CNPJ=

USAGE_DAILY_DOCUMENT_UPLOADS=20
USAGE_DAILY_DOCUMENT_AI=20
USAGE_DAILY_AI_CHAT=50
USAGE_DAILY_DATAJUD_CNJ=20
USAGE_DAILY_OCR=10
USAGE_MONTHLY_CONTRACT_ANALYSIS=20
USAGE_MONTHLY_DRAFT_GENERATION=10
USAGE_MONTHLY_INFO_EXTRACTION=20

RATE_LIMIT_STORAGE_PATH=backend/storage/rate-limits
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
PROFILE_PHOTO_STORAGE_PATH=backend/storage/profile_photos
DOCUMENT_STORAGE_PATH=storage-private/documents
ATTACHMENT_STORAGE_PATH=storage-private/message-attachments
CLAMAV_BINARY=
CLAMAV_TIMEOUT_SECONDS=15
OCR_ENABLED=false
OCR_TESSERACT_BINARY=
OCR_LANGUAGE=por+eng
OCR_TIMEOUT_SECONDS=30
PDFTOTEXT_BINARY=

ASYNC_JOBS_ENABLED=false
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=change-me-before-production

# Producao:
# - APP_URL, APP_PUBLIC_URL e HEALTHCHECK_URL devem usar HTTPS real.
# - BACKUP_ENCRYPTION_PASSWORD e obrigatorio para backups criptografados.
# - CLAMAV_BINARY deve apontar para o executavel do ClamAV em ambientes com uploads reais.
