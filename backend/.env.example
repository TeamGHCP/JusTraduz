# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seudominio.com.br/JusTraduz
APP_BASE_PATH=JusTraduz
APP_TIMEZONE=America/Sao_Paulo
HEALTHCHECK_URL=https://seudominio.com.br/JusTraduz/backend/public/index.php?rota=/health

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=justraduz
DB_USER=root
DB_PASS=
# DB_DSN=

# Session and security
SESSION_SECURE=true
CSRF_SECRET=
HEALTHCHECK_TOKEN=

# Mail
MAIL_LOG_ONLY=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@seudominio.com.br
MAIL_FROM_NAME=JusTraduz

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI and external integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DATA_PROCESSING_APPROVED=false
DATAJUD_API_KEY=
DATAJUD_API_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_CACHE_TTL_HOURS=24
DATAJUD_CONNECT_TIMEOUT=10
DATAJUD_TIMEOUT=30
DATAJUD_SSL_VERIFY=true
OAB_API_URL=

# Storage
DOCUMENT_STORAGE_PATH=storage-private/documents
ATTACHMENT_STORAGE_PATH=storage-private/message-attachments
PROFILE_PHOTO_STORAGE_PATH=backend/storage/profile_photos

# Upload scanning and OCR
RATE_LIMIT_STORAGE_PATH=backend/storage/rate-limits
CLAMAV_BINARY=
CLAMAV_TIMEOUT_SECONDS=15
OCR_ENABLED=false
OCR_TESSERACT_BINARY=
OCR_TIMEOUT_SECONDS=30
OCR_LANGUAGE=por+eng
PDFTOTEXT_BINARY=

# Usage limits
USAGE_DAILY_DOCUMENT_UPLOADS=20
USAGE_DAILY_DOCUMENT_AI=20
USAGE_DAILY_AI_CHAT=50
USAGE_DAILY_DATAJUD_CNJ=20
USAGE_DAILY_OCR=10

# Backups
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=

# Jobs
ASYNC_JOBS_ENABLED=false
